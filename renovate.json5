{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':dependencyDashboard',
  ],
  timezone: 'America/Argentina/Buenos_Aires',
  // Sin `schedule` a proposito: Renovate corre self-hosted, disparado por el
  // cron de .github/workflows/renovate.yml, que es la unica fuente de verdad
  // del horario. Agregar una ventana aca la duplica y puede bloquear la
  // corrida: el cron dispara domingo ~22:00 local, y una ventana de
  // 'before 6am on monday' dejaba todo en "Awaiting Schedule" sin crear PRs.
  separateMinorPatch: true,
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  labels: [
    'dependencies',
    'renovate',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^defaults/main\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+authkeysync_version:\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major-update',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'all patches',
      groupSlug: 'all-patches',
    },
  ],
}
