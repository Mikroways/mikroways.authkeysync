#!/bin/sh
# Hook versionado: se activa solo via `core.hooksPath` (lo configura el script
# `prepare` de package.json al correr `npm install`).
#
# Replica el job `docs` de CI (Mikroways/mw-docs-quality lint.yml): markdownlint
# + cspell. Evita commitear markdown roto que despues falla en main y, por
# arrastre, bloquea todos los PRs abiertos.

# Solo corre si hay archivos .md staged.
staged_md=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
[ -z "$staged_md" ] && exit 0

# node_modules ausente = el lint no puede correr. Fallar ruidosamente en vez de
# dejar pasar el commit sin validar: asi entro el error que rompio main.
if [ ! -d node_modules/@mikroways/docs-quality ]; then
  echo "pre-commit: falta node_modules/@mikroways/docs-quality" >&2
  echo "pre-commit: corre \`npm install\` antes de commitear markdown." >&2
  exit 1
fi

# El CI usa siempre @latest (mw-docs-quality lint.yml); si el local queda atras,
# el diccionario de cspell difiere y el job docs falla aunque el hook pase.
# Si no hay red, se avisa y se sigue con la version instalada.
latest=$(npm view @mikroways/docs-quality version 2>/dev/null)
current=$(node -p "require('./node_modules/@mikroways/docs-quality/package.json').version" 2>/dev/null)
if [ -n "$latest" ] && [ "$latest" != "$current" ]; then
  echo "pre-commit: actualizando docs-quality $current -> $latest..."
  npm install --no-save --no-audit --no-fund --silent \
    @mikroways/docs-quality@latest ||
    echo "pre-commit: no se pudo actualizar docs-quality, sigo con $current." >&2
fi

fail=0

echo "pre-commit: markdownlint..."
npx --no-install markdownlint-cli2 || fail=1

echo "pre-commit: cspell..."
npx --no-install cspell "**/*.md" || fail=1

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "pre-commit: el lint de docs fallo." >&2
  echo "pre-commit: arregla lo de arriba, o saltea con \`git commit --no-verify\`" >&2
  echo "pre-commit: si sabes lo que estas haciendo (CI lo va a validar igual)." >&2
  exit 1
fi

exit 0
